      "content": "<div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"24\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Experience working in a cleanroom environment</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"25\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Experience in the aerospace industry</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"26\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">An understanding of the theory behind power, digital, and analog circuits</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"27\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Familiarity with RF connectors, cables, and test equipment</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"28\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Knowledge of safe fabrication practices, milling machine and drill press</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"29\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Manufacturing Execution System (MES) familiarity</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"30\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Experience in a fast-paced work environment, managing a variety of changing tasks</span></p>\n</li>\n\n</ul></div>\n</div>"
