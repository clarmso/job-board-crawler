      "text": "Key Responsibilities:",
      "content": "<div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"1\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Mechanical and Electrical assembly of PCBAs into chassis&nbsp;</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"2\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"none\">Building wire harness applying space related requirements</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Soldering and de-soldering through-hole and SMT components</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Adhesive and epoxy application (conformal coat, masking, staking)</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"5\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">PCBA inspection and rework</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"6\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Subsystem (including electro-mechanical assembly) build and test</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"7\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Satellite assembly and integrated test support</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"8\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Quality control awareness in a team environment</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"9\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"0\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Component, assembly, and satellite design support for process improvement</span></p>\n</li>\n\n</ul></div>\n<div>\n<ul role=\"list\" style=\"list-style-type: square;\">\n<li aria-setsize=\"-1\" data-leveltext=\"\" data-font=\"Wingdings\" data-listid=\"9\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:2160,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Wingdings&quot;,&quot;469769242&quot;:[9642],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" data-aria-posinset=\"1\" data-aria-level=\"3\" role=\"listitem\">\n<p><span data-contrast=\"auto\">Travel to support Spacecraft environmental testing and launch integration&nbsp; </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p>\n</li>\n\n</ul></div>\n</div>"
